<Window x:Class="MainApp.NewPostingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainApp"
        mc:Ignorable="d"
        Title="Add New Job Posting" Height="auto" Width="auto">
    <StackPanel Orientation="Vertical">
        <Border BorderBrush="Black" BorderThickness="1">
            <Grid Width="auto"  ShowGridLines="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />

                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock FontSize="12" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Padding="5" HorizontalAlignment="Right">Job Title</TextBlock>
                <TextBox Grid.Row="0" Grid.Column="1" Width="auto" Height="25"/>

                <TextBlock FontSize="12" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Padding="5" HorizontalAlignment="Right">Company Name</TextBlock>
                <TextBox Grid.Row="1" Grid.Column="1" Width="auto" Height="25"/>

                <TextBlock FontSize="12" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Padding="5" HorizontalAlignment="Right">Posting URL</TextBlock>
                <TextBox Grid.Row="2" Grid.Column="1" Width="auto" Height="25"/>

                <TextBlock FontSize="12" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Padding="5" HorizontalAlignment="Right">Job Type</TextBlock>
                <ComboBox Grid.Row="3" Grid.Column="1" Width="auto" Height="25"/>

                <TextBlock FontSize="12" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Padding="5" HorizontalAlignment="Right">Job Arrangement</TextBlock>
                <ComboBox Grid.Row="4" Grid.Column="1" Width="auto" Height="25"/>

                <TextBlock FontSize="12" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Padding="5" HorizontalAlignment="Right">Location</TextBlock>
                <TextBox Grid.Row="5" Grid.Column="1" Width="auto" Height="25"/>

                <TextBlock FontSize="12" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Padding="5" HorizontalAlignment="Right">Description</TextBlock>
                <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="1">
                    <Button Content="Edit Description" Width="150" Margin="5"/>
                    <TextBlock Name="descButton" Text="(0 chars set)" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock FontSize="12" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Padding="5" HorizontalAlignment="Right">Status</TextBlock>
                <ComboBox Grid.Row="7" Grid.Column="1" Width="auto" Height="25"/>
            </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="75" Margin="5"/>
            <Button Content="Cancel" Width="75" Margin="5"/>
        </StackPanel>
    </StackPanel>
</Window>
