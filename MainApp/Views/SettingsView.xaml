<Window x:Class="MainApp.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainApp"
        xmlns:views="clr-namespace:MainApp.Views"
        xmlns:viewModels="clr-namespace:MainApp.ViewModels"
        mc:Ignorable="d"
        Title="Settings" Height="450" Width="800"
        WindowStartupLocation="CenterOwner">
    <Window.DataContext>
        <viewModels:SettingsViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <ControlTemplate x:Key="ErrorTextBelow">
            <StackPanel Focusable="False" IsHitTestVisible="False">
                <Border BorderBrush="Red" BorderThickness="1">
                    <AdornedElementPlaceholder/>
                </Border>
                <TextBlock Text="{Binding [0].ErrorContent}"
                           Foreground="Red"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ControlTemplate>

        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ErrorTextBelow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0" VerticalAlignment="Top" Margin="10" Padding="5" Width="auto" Height="auto">
            <GroupBox.Header>
                <TextBlock Text="Database Settings" FontSize="12"/>
            </GroupBox.Header>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Location:"
                           VerticalAlignment="Center"
                           Margin="10"/>
                <TextBox Name="saveLocationTextbox"
                         Width="450" Height="25"
                         Margin="10"
                         VerticalContentAlignment="Center"
                         Text="{Binding SaveLocation, Mode=TwoWay}"/>
                <Button Name="browseButton"
                        Content="Browse" 
                        Width="75" Height="25"
                        Margin="10"
                        Click="browseButton_Click"/>
                <Button Name="saveLocationResetButton"
                        Width="25" Height="25" 
                        Margin="10"
                        Click="saveLocationResetButton_Click">
                    <Image Source="/Restart.png" Width="70" Height="16"/>
                </Button>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="1" Margin="10" Padding="5">
            <GroupBox.Header>
                <TextBlock Text="Current Location (Required for Distance Calculations)"/>
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                           Text="Location: " 
                           VerticalAlignment="Center" 
                           Margin="10"/>
                <views:LocationControl Grid.Column="1"
                                       x:Name="locationControl"
                                       Validation.ErrorTemplate="{x:Null}"
                                       LocationInput="{Binding DataContext.LocationInput, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                       LocationResult="{Binding DataContext.LocationFullName, Mode=OneWayToSource, RelativeSource={RelativeSource AncestorType=Window}}"
                                       IsValid="{Binding DataContext.LocationValid, Mode=OneWayToSource, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </GroupBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="saveButton"
                    Content="Save"
                    Width="75"
                    Margin="5"
                    Command="{Binding SaveCommand}"/>
            <Button Name="cancelButton"
                    Content="Cancel"
                    Width="75"
                    Margin="5"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
