<Window x:Class="MainApp.Views.EditLocationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainApp"
        xmlns:views="clr-namespace:MainApp.Views"
        xmlns:viewmodels="clr-namespace:MainApp.ViewModels"
        mc:Ignorable="d"
        Title="Edit Location"
        MinWidth="300"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
    
    <Window.DataContext>
        <viewmodels:EditLocationViewModel x:Name="ViewModel"/>
    </Window.DataContext>
    
    <Window.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/TextButtonStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Window.Resources>
    
    <DockPanel>
        <views:LocationView DockPanel.Dock="Top"
                            x:Name="locationControl"
                            LocationInput="{Binding DataContext.LocationInput, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}"
                            LocationResult="{Binding DataContext.LocationResult, Mode=OneWayToSource, RelativeSource={RelativeSource AncestorType=Window}}"
                            IsValid="{Binding DataContext.LocationValid, Mode=OneWayToSource, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <StackPanel Orientation="Horizontal" 
                    DockPanel.Dock="Bottom" 
                    HorizontalAlignment="Right">
            <Button Content="Save"
                    Style="{StaticResource TextButtonStyle}"
                    Command="{Binding SaveCommand}"/>
            <Button Content="Cancel"
                    Style="{StaticResource TextButtonStyle}"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </DockPanel>
</Window>
