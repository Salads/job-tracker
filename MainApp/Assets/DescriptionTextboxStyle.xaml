<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Assets/Globals.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style TargetType="TextBox" x:Key="DescriptionTextBoxStyle">
        <Setter Property="Margin" Value="{StaticResource Globals.Margin}"/>
    </Style>
</ResourceDictionary>